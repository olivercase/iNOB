# Kathleen profile (UCL Research Computing — full node, MPI parallel env).

PROFILE_NAME=kathleen
SCHEDULER=sge
REMOTE_HOST=kathleen
REMOTE_BASE="\${HOME}/Scratch/inob"

# ── job-array shape ────────────────────────────────────────────────────────
N_CHUNKS=32
TASKS=2                  # 2 tasks × 16 parallel chunks/task = 32
CHUNKS_PER_TASK=16
PE_DIRECTIVE="mpi 80"    # Kathleen requires the mpi parallel-environment
CORES_PER_TASK=80
MEM_PER_TASK=2G
WALLTIME_ARRAY=4:00:00
WALLTIME_BUILD=3:00:00
WALLTIME_REDUCE=0:30:00
BLAS_THREADS=5           # 80 cores / 16 parallel chunks ≈ 5 BLAS threads/chunk

# ── modules ────────────────────────────────────────────────────────────────
MODULES=(
    gcc-libs/10.2.0
    compilers/gnu/10.2.0
    cmake/3.21.1
    openblas/0.3.13-openmp/gnu-10.2.0
    eigen/3.4.0/gnu-10.2.0
    python/3.11.4-gnu-10.2.0
)
