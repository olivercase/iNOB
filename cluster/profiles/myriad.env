# Myriad profile (UCL Research Computing).
# Sourced by cluster/lib.sh; values override the user/local defaults.

PROFILE_NAME=myriad
SCHEDULER=sge
REMOTE_HOST=myriad
REMOTE_BASE="\${HOME}/Scratch/duneuro"

# ── job-array shape ────────────────────────────────────────────────────────
N_CHUNKS=32
TASKS=32                 # one task per chunk
CHUNKS_PER_TASK=1
PE_DIRECTIVE="smp 4"     # parallel-environment directive
CORES_PER_TASK=4
MEM_PER_TASK=8G
WALLTIME_ARRAY=4:00:00
WALLTIME_BUILD=3:00:00
WALLTIME_REDUCE=0:30:00
BLAS_THREADS=4

# ── modules ────────────────────────────────────────────────────────────────
MODULES=(
    gcc-libs/10.2.0
    compilers/gnu/10.2.0
    cmake/3.21.1
    openblas/0.3.13-openmp/gnu-10.2.0
    eigen/3.4.0/gnu-10.2.0
    python/3.11.4-gnu-10.2.0
)
